generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum Perfil {
  GERENTE
  FUNCIONARIO
}

enum Especie {
  CACHORRO
  GATO
}

enum Porte {
  PEQUENO
  MEDIO
  GRANDE
}

enum Servico {
  BANHO
  TOSA
}

enum StatusAgendamento {
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

// ==================== TABELAS ====================

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  usuario      String   @unique
  senhaHash    String
  perfil       Perfil   @default(FUNCIONARIO)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  sessoes      Sessao[]
  agendamentos Agendamento[]

  @@map("usuarios")
}

model Sessao {
  id          String    @id @default(uuid())
  usuarioId   Int
  criadaEm    DateTime  @default(now()) @db.Timestamptz(3)
  expiraEm    DateTime  @db.Timestamptz(3)
  encerradaEm DateTime? @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

model Pet {
  id            Int      @id @default(autoincrement())
  nome          String
  especie       Especie
  raca          String?
  porte         Porte?
  observacoes   String?
  foto          String? // nome do arquivo em uploads/pets
  tutorNome     String
  tutorTelefone String
  tutorEndereco String
  criadoEm      DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @db.Timestamptz(3)

  agendamentos Agendamento[]

  @@map("pets")
}

model Agendamento {
  id           Int               @id @default(autoincrement())
  data         DateTime          @db.Date
  hora         Int               // hora de início: 8 a 17
  servico      Servico
  status       StatusAgendamento @default(AGENDADO)
  observacoes  String?
  petId        Int
  criadoPorId  Int
  criadoEm     DateTime          @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime          @updatedAt @db.Timestamptz(3)

  pet       Pet     @relation(fields: [petId], references: [id], onDelete: Restrict)
  criadoPor Usuario @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([data])
  @@index([petId])
  @@map("agendamentos")
}